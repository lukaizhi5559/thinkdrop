# ─────────────────────────────────────────────────────────────────────────────
# ThinkDrop root .env.example
#
# Copy to .env and fill in values. This is the PRIMARY .env file — loaded by
# src/main/main.js at startup via require('dotenv').config() before any other
# module is required. All vars here are available to the Electron main process,
# the renderer (via IPC), and all stategraph nodes.
#
# NOTE: stategraph-module/.env is NOT loaded under Electron — any var that
# stategraph nodes read at runtime MUST be in this file. See "StateGraph runtime
# vars" section below.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM streaming backend ────────────────────────────────────────────────────
BASE_API_KEY=your-api-key-here
BASE_URL=http://localhost:4000
WEBSOCKET_URL=ws://localhost:4000/ws/stream
WEBSOCKET_API_KEY=

# ── Development ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ── MCP Service URLs (StateGraph routing) ────────────────────────────────────
MCP_CONVERSATION_URL=http://127.0.0.1:3004
MCP_USER_MEMORY_URL=http://127.0.0.1:3001
MCP_WEB_SEARCH_URL=http://127.0.0.1:3002
MCP_COMMAND_URL=http://127.0.0.1:3007
MCP_SCREEN_INTELLIGENCE_URL=http://127.0.0.1:3008
MCP_PHI4_URL=http://127.0.0.1:3009
MCP_COREFERENCE_URL=http://127.0.0.1:3005
MCP_VOICE_URL=http://127.0.0.1:3006

# ── MCP Service API keys (per-service) ───────────────────────────────────────
MCP_USER_MEMORY_API_KEY=
MCP_WEB_SEARCH_API_KEY=
MCP_COMMAND_API_KEY=
MCP_CONVERSATION_API_KEY=
MCP_PHI4_API_KEY=
MCP_COREFERENCE_API_KEY=
MCP_SCREEN_INTELLIGENCE_API_KEY=

# Shared MCP API key (used for all services unless overridden per-service above)
MCP_API_KEY=

# ── OAuth Provider Credentials (Skills tab "Connect" button) ─────────────────
# Each provider needs an OAuth app created in its developer console.
# Only fill in the providers you use — empty values are safely ignored.

# Google  →  console.cloud.google.com  →  APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=

# GitHub  →  github.com/settings/developers  →  OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft  →  portal.azure.com  →  App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Facebook / Meta  →  developers.facebook.com  →  My Apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Twitter / X  →  developer.twitter.com  →  Projects & Apps
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn  →  linkedin.com/developers  →  My Apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Slack  →  api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion  →  notion.so/my-integrations  (Public integration = OAuth app)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Spotify  →  developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dropbox  →  dropbox.com/developers/apps
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Discord  →  discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Zoom  →  marketplace.zoom.us  →  Develop → Build App
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Atlassian (Jira / Confluence)  →  developer.atlassian.com  →  Apps
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Salesforce  →  setup → App Manager → New Connected App
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HubSpot  →  developers.hubspot.com  →  Apps
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Voice / STT services ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
VOICE_SERVICE_URL=http://127.0.0.1:3006
VOICE_SERVICE_PORT=3006

# Deepgram Nova-2 STT (primary STT — keyword boosting for Armis/ThinkDrop)
DEEPGRAM_API_KEY=
DEEPGRAM_KEYWORDS=Armis:5,ThinkDrop:5,Perplexity:3,Claude:3,ChatGPT:3

# ── External API keys ────────────────────────────────────────────────────────
# NumVerify — phone carrier lookup for SMS gateway routing
NUMVERIFY_API_KEY=

# ── ThinkDrop feature flags ──────────────────────────────────────────────────
# Browser driver for CLI agent automation: "playwright" | "puppeteer" | "" (none)
THINKDROP_CLI_DRIVER=playwright

# Grill-Me architecture: deterministic pre-planning via exhaustive probing +
# batched questioning + memory recording.
#   1 = enabled (probe desktop/TCC, resolve route CLI>desktop>browser,
#       memory-first batched Q&A with QuestionCard UI, answers recorded to memory)
#   0 = disabled (legacy single-question gather loop, no probes)
THINKDROP_GRILL_MODE=0

# Allow preflightAgents to auto-generate trained recipes when a matching skill
# is found but no trained recipe exists. Default: off.
THINKDROP_ALLOW_AUTOGENERATED_RECIPES=false

# ── StateGraph runtime vars ──────────────────────────────────────────────────
# These are read by stategraph nodes at runtime. Under Electron they MUST be
# here (stategraph-module/.env is not loaded). When running stategraph standalone
# (tests, direct node scripts), they can also be set in stategraph-module/.env.

# Service ports (used by nodes that connect directly, not via MCP adapter)
MEMORY_SERVICE_PORT=3001
PERSONALITY_SERVICE_PORT=3008
OVERLAY_CONTROL_PORT=3010

# Playwright CLI binary path (used by taskRunner for browser automation)
PLAYWRIGHT_CLI_BIN=/opt/homebrew/bin/playwright-cli

# Long-running task timeout in milliseconds (default: 30 minutes)
LONG_TASK_TIMEOUT_MS=1800000
